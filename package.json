{
  "name": "arcadia-vault",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "nodemon server.js",
    "dev:web": "vite",
    "build": "vite build",
    "start": "node server.js",
    "test:security-lab": "node --test test/ip-policy.test.js",
    "test:auth-rate-limit": "node test/auth-rate-limit-local.mjs",
    "test:auth-race": "node test/auth-race-local.mjs",
    "test:ip-chain": "node test/validator-connector-differential.mjs",
    "test:redos-screening": "node test/redos-screening.mjs",
    "test:redos-fuzz": "node test/redos-fuzz.mjs",
    "test:redos-libraries": "node test/redos-library-review.mjs",
    "test:redos-focused": "node test/redos-focused-review.mjs",
    "test:redos-http": "node test/redos-http-review.mjs",
    "test:redos-http-authenticated": "node test/redos-http-authenticated.mjs",
    "test:dependency-risks": "node test/dependency-risk-scenarios.mjs",
    "test:password-policy": "node --test test/password-policy.test.mjs",
    "test:public-rom": "node --test test/public-rom-projection.test.mjs",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:seed": "node prisma/seed.js"
  },
  "dependencies": {
    "@prisma/client": "^6.12.0",
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^17.2.1",
    "express": "^5.1.0",
    "express-rate-limit": "^8.0.1",
    "ip-range-check": "0.2.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.2",
    "nodemailer": "^9.0.3",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router": "^8.3.0",
    "request-ip": "3.3.0",
    "swagger-ui-express": "^5.0.1",
    "three": "^0.178.0",
    "zod": "^4.0.10"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.2.0",
    "nodemon": "^3.1.10",
    "prisma": "^6.12.0",
    "vite": "^7.0.6"
  }
}
